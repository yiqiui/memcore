{
  "name": "@memcore/core",
  "version": "0.2.0",
  "description": "Storage-agnostic, strategy-pluggable memory engine core for AI agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test --if-present"
  },
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOURNAME/memcore.git"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "embeddings",
    "sqlite",
    "lancedb",
    "pgvector",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "author": "memcore contributors"
}
